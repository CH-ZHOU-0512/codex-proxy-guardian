  "MaxProcessProxyCandidates": 6,
  "CodexPackageNames": [
    "OpenAI.Codex"
  ],
  "CodexApplicationId": "",
  "UseChromiumProxyArgument": true,
  "ManageExternalCodexLaunches": false,
  "NoProxy": "localhost,127.0.0.1,::1",
  "LogRetentionDays": 14,
  "MaxLogFiles": 20,
  "MaxLogFileMB": 5
