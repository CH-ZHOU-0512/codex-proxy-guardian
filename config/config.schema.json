{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-proxy-guardian:config:v1",
  "title": "Codex Proxy Guardian configuration",
  "type": "object",
  "required": ["SchemaVersion", "Mode", "PollSeconds", "ProxyTestUrls", "CodexPackageNames"],
  "properties": {
    "SchemaVersion": { "const": 1 },
    "Mode": { "enum": ["Safe", "Enforce"] },
    "PollSeconds": { "type": "integer", "minimum": 2, "maximum": 300 },
    "StableSamples": { "type": "integer", "minimum": 1, "maximum": 100 },
    "DebounceSeconds": { "type": "integer", "minimum": 0, "maximum": 600 },
    "ExternalLaunchDebounceSeconds": { "type": "integer", "minimum": 0, "maximum": 600 },
    "RestartCooldownSeconds": { "type": "integer", "minimum": 10, "maximum": 3600 },
    "RestartLimitCount": { "type": "integer", "minimum": 1, "maximum": 100 },
    "RestartLimitWindowMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "CircuitBreakerMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "RecoveryLaunchRetrySeconds": { "type": "integer", "minimum": 5, "maximum": 600 },
    "GracefulCloseSeconds": { "type": "integer", "minimum": 0, "maximum": 60 },
    "TcpTimeoutMilliseconds": { "type": "integer", "minimum": 100, "maximum": 10000 },
    "HttpTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
    "HttpValidationIntervalSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "UnavailableLogIntervalSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
    "ExplicitProxy": { "type": "string" },
    "AllowNonLoopbackProxy": { "type": "boolean" },
    "EnableEnvironmentProxyDiscovery": { "type": "boolean" },
    "ProxyTestUrls": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "MinimumSuccessfulProxyTests": { "type": "integer", "minimum": 1, "maximum": 20 },
    "PreferredProxyProcesses": { "type": "array", "items": { "type": "string" } },
    "PreferredProxyPorts": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
    "MaxProcessProxyCandidates": { "type": "integer", "minimum": 1, "maximum": 50 },
    "CodexPackageNames": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "CodexApplicationId": { "type": "string" },
    "CodexResolveIntervalSeconds": { "type": "integer", "minimum": 10, "maximum": 3600 },
    "ProxyConnectionEvidenceWindowSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
    "UseChromiumProxyArgument": { "type": "boolean" },
    "ManageExternalCodexLaunches": { "type": "boolean" },
    "NoProxy": { "type": "string" },
    "LogRetentionDays": { "type": "integer", "minimum": 1, "maximum": 365 },
    "MaxLogFiles": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "MaxLogFileMB": { "type": "integer", "minimum": 1, "maximum": 100 }
  },
  "additionalProperties": true
}
